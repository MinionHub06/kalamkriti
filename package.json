{
  "name": "kalamkriti-backend",
  "version": "1.0.0",
  "description": "Backend API for KalamKriti handloom platform",
  "main": "server.js",
  "scripts": {
    "install-deps": "node install-dependencies.js",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "setup": "node setup.js",
    "test": "node test-connection.js",
    "db:connect": "node database/dbUtils.js connect",
    "db:disconnect": "node database/dbUtils.js disconnect",
    "db:migrate": "node database/dbUtils.js migrate",
    "db:rollback": "node database/dbUtils.js rollback",
    "db:seed": "node database/dbUtils.js seed",
    "db:reset": "node database/dbUtils.js reset",
    "db:stats": "node database/dbUtils.js stats",
    "db:health": "node database/dbUtils.js health",
    "db:help": "node database/dbUtils.js help"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.8.7"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "keywords": [
    "handloom",
    "ecommerce",
    "api"
  ],
  "author": "KalamKriti Team",
  "license": "MIT"
}
